# `engines` in package.json is advisory by default: npm prints a warning and installs anyway, which
# for a floor that exists because of a *flag* is the wrong failure. `--test-coverage-include-all`
# arrived in Node 26.7.0 and nothing below that recognises it, so `npm run coverage` on an older
# runtime does not report a weaker number — it exits on an unknown option, and the 100% gate the
# front end is held to simply never runs.
#
# This makes the floor a refusal at install time, where it can still be read as a version problem.
engine-strict=true
