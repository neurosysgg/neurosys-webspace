{
  // Sources live outside public/ so they are neither web-served nor deployed — deploy.sh only
  // ships public/, src/, autoload.php and data/. The emitted .js is committed; see docs/testing.md
  // for the check that keeps it in step with these sources.
  "include": ["assets/ts/**/*.ts"],

  "compilerOptions": {
    "rootDir": "assets/ts",
    "outDir": "public/assets/js",

    // Plain browser ES modules, no bundler. nodenext + "type": "module" in package.json makes an
    // extensionless relative import a compile error, so a specifier the browser would 404 on
    // cannot ship — the same instinct as CspHost rejecting anything but a bare origin.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // A type error must never leave stale or half-written JS sitting in public/ waiting to deploy.
    "noEmitOnError": true,

    // Comments are half of what ships and the second copy of something already sent: 49,925 bytes
    // raw and 24,350 gzipped with them, 24,770 and 11,298 without. inlineSources below embeds the
    // TypeScript — comments intact — in the map's sourcesContent, so DevTools shows the commented
    // source either way. Keeping them in the .js as well is a copy only the network pays for.
    //
    // This used to say it was the whole of the minification question — that a real minifier past
    // this point was worth about 260 gzipped bytes, because gzip already does what identifier
    // mangling does. That figure was measured over a *concatenated* stream, where gzip's window
    // spans the whole graph. Nothing here is bundled, so the browser makes 42 separate requests and
    // each one's window is a single small module. Measured that way: 11,807 gzipped bytes before,
    // 9,555 after — 2,252 saved, 19.1%. gzip is much less redundant with mangling than it looked.
    //
    // So there is a minifier now, and it is deliberately not here. tsc's output is the *debug*
    // tree: test/js/ imports it by path, the coverage gate is pinned to those paths, and the verify
    // script diffs it byte-for-byte against a fresh compile — all three want something a person can
    // read. tools/build-prod.mjs derives build/dist/ from it instead, and that is what deploy.sh
    // ships. See the note on sourceMap below, and CLAUDE.md's "Debug and prod builds".
    "removeComments": true,
    "newLine": "lf",

    // inlineSources embeds the TypeScript in the map's sourcesContent, so DevTools shows Navigation.ts
    // without assets/ts/ having to be a served directory. Read that precisely: the sources are not
    // web-exposed at their own paths, but they ARE served — /assets/js/Navigation.js.map carries the
    // whole commented original, and static assets never reach PHP, so neither auth gate covers them.
    //
    // **That now applies to local dev and not to the live host.** tools/build-prod.mjs deletes every
    // map from the tree deploy.sh ships and asserts no module still names one, so what used to be
    // 79,354 bytes of commented TypeScript on a public URL is 42 files that are not there. The
    // source is public on GitHub, which was always a reason not to worry about it rather than a
    // reason to serve a second copy from Strato. On a project where the source is not public the
    // fix is still dropping inlineSources — a prod-only strip protects what is deployed, not what
    // is running on a laptop with the dev server bound to something other than localhost.
    //
    // Maps are only fetched with DevTools open. public/.htaccess still needs a "map" handler or
    // Strato 500s them, because the debug tree is what `npm run dev` serves.
    "sourceMap": true,
    "inlineSources": true
  }
}
