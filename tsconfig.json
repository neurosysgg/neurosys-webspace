{
  // Sources live outside public/ so they are neither web-served nor deployed — deploy.sh only
  // ships public/, src/, autoload.php and data/. The emitted .js is committed; see docs/testing.md
  // for the check that keeps it in step with these sources.
  "include": ["assets/ts/**/*.ts"],

  "compilerOptions": {
    "rootDir": "assets/ts",
    "outDir": "public/assets/js",

    // Plain browser ES modules, no bundler. nodenext + "type": "module" in package.json makes an
    // extensionless relative import a compile error, so a specifier the browser would 404 on
    // cannot ship — the same instinct as CspHost rejecting anything but a bare origin.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // A type error must never leave stale or half-written JS sitting in public/ waiting to deploy.
    "noEmitOnError": true,

    // Comments are about half of what tsc emits, and a second copy of something already sent:
    // inlineSources below embeds the TypeScript — comments intact — in the map's sourcesContent, so
    // DevTools shows the commented source either way. Keeping them in the .js as well is a copy only
    // the network pays for.
    //
    // Minification is deliberately not here. tsc's output is the *debug* tree: test/js/ imports it
    // by path, the coverage gate is pinned to those paths, and the verify script diffs it
    // byte-for-byte against a fresh compile — all three want something a person can read.
    // tools/build-prod.mjs derives build/dist/ from it, bundled and minified, and that is what
    // ships. See the note on sourceMap below, and docs/frontend.md's "Debug and prod".
    "removeComments": true,
    "newLine": "lf",

    // inlineSources embeds the TypeScript in the map's sourcesContent, so DevTools shows Navigation.ts
    // without assets/ts/ having to be a served directory. Read that precisely: the sources are not
    // web-exposed at their own paths, but they ARE served — /assets/js/Navigation.js.map carries the
    // whole commented original, and static assets never reach PHP, so neither auth gate covers them.
    //
    // **That applies to local dev and not to the live host.** tools/build-prod.mjs deletes every
    // map from the tree that ships and asserts no module still names one. The source is public on
    // GitHub, which is a reason not to worry about it rather than a reason to serve a second copy
    // from Strato. On a project where the source is not public the
    // fix is still dropping inlineSources — a prod-only strip protects what is deployed, not what
    // is running on a laptop with the dev server bound to something other than localhost.
    //
    // Maps are only fetched with DevTools open. public/.htaccess still needs a "map" handler or
    // Strato 500s them, because the debug tree is what `npm run dev` serves.
    "sourceMap": true,
    "inlineSources": true
  }
}
