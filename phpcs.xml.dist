<?xml version="1.0"?>
<ruleset name="NeuroSYS">
    <description>PSR-12. The only exemptions are the sniffs that fight column-aligned parameters
        and one-line accessor methods; file headers and control structures follow PSR-12 exactly.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- The only warnings left are long lines of HTML inside heredocs, which can't be
         wrapped without changing the output. Report them, don't fail the build on them. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- autoload.php is named explicitly because it sits at the root rather than in a directory,
         so a <file> entry for a folder never reached it. It is the file the whole site loads
         through and the only one using the pipe operator; it was linted by nothing. -->
    <file>autoload.php</file>
    <file>src</file>
    <file>public</file>
    <file>test</file>
    <file>data</file>
    <file>tools</file>

    <!-- Composer dev dependencies are not ours to lint. -->
    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="PSR12">
        <!-- allows `private array  $segments` column-alignment across constructor params -->
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpacingAfterHint"/>
        <!-- allows one-line accessors: `public function all(): array { return $this->items; }` -->
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.BraceOnSameLine"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.ContentAfterBrace"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
        <!-- allows column-aligned call arguments, the way data/releases.php lines up
             `new Format(ReleaseFormat::FLAC,  new HiDriveLink(…))` across entries -->
        <exclude name="Generic.Functions.FunctionCallArgumentSpacing.TooMuchSpaceAfterComma"/>
        <!-- allows column-aligned defaults: `public SoundCloudPlayerStyle $style  = …` -->
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpaceBeforeEquals"/>
        <exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing.SpaceAfterEquals"/>
    </rule>

    <!-- ── PHPDoc completeness, adopted 2026-09-05 ──────────────────────────────────────────
         Every function documents each parameter and its return type. This started as a PhpStorm
         pass, which used `PhpMissingDocCommentInspection` — that flags a method with *no* docblock
         and leaves any method that already has one alone, however incomplete. The result was
         inverted: `Layout::head()` got tags, `Element::attr()` with its long prose docblock got
         none. Stating the rule here instead makes it the same rule everywhere and for everyone.

         Three readers, one statement: `composer lint`, PhpStorm's PhpCS inspection, and Neovim's
         nvim-lint, which resolves this ruleset from the buffer's project root.

         The excluded sub-rules are the ones that would fight decisions this project already made:
         column alignment (which the sniff exemptions above exist to protect), prose style, and
         type spellings that PHP's own signature already states more precisely than a docblock can.
         What is left is exactly "is every parameter named, and is the return type stated". -->
    <rule ref="Squiz.Commenting.FunctionComment">
        <!-- A tag names the parameter; it does not owe a sentence. Most of these types say
             everything there is to say, and a mandated comment invites restating the name. -->
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <!-- Column alignment is house style; the ruleset already exempts the sniffs that fight it
             in a signature, and these are the same argument inside a docblock. -->
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamType"/>
        <exclude name="Squiz.Commenting.FunctionComment.SpacingAfterParamName"/>
        <!-- `@throws MarkupException if …` reads as a sentence about a condition, not a heading. -->
        <exclude name="Squiz.Commenting.FunctionComment.ThrowsNotCapital"/>
        <exclude name="Squiz.Commenting.FunctionComment.EmptyThrows"/>
        <!-- The signature is the authority on types. These want a docblock to disagree with it —
             `integer` for `int`, a scalar hint the parameter already carries — which is the
             opposite of how this codebase treats the two. -->
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
        <exclude name="Squiz.Commenting.FunctionComment.ScalarTypeHintMissing"/>
        <exclude name="Squiz.Commenting.FunctionComment.TypeHintMissing"/>
        <exclude name="Squiz.Commenting.FunctionComment.InvalidReturn"/>
        <exclude name="Squiz.Commenting.FunctionComment.InvalidReturnNotVoid"/>
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectParamVarName"/>
    </rule>

    <!-- A bootstrap and a data file both have to load something *and* define something;
         that is what they are for. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>test/bootstrap.php</exclude-pattern>
        <exclude-pattern>data/*.php</exclude-pattern>
    </rule>

    <!-- data/*.php are configuration, not classes: a `use` block followed by a docblock
         and a `return` is the shape, and PSR-12's file-header rules don't describe it. -->
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>data/*.php</exclude-pattern>
    </rule>
</ruleset>
