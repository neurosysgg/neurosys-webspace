# Logs — operational data, don't commit
data/logs/

# OS junk
.DS_Store

# JetBrains (PHPStorm/IntelliJ) — can contain deployment hostnames/credentials
.idea/

# Deploy script contains credentials
deploy.sh

# Pre-public site auth — dot-prefix the file to disable the gate without losing it
data/site_auth.php
data/.site_auth.php

# Composer dev dependencies (PHPUnit) — dev-only, never deployed
/vendor/
.phpunit.cache/
.php-cs-fixer.cache

# npm dev dependencies (TypeScript) — same deal, dev-only and never deployed. The *compiled*
# JS in public/assets/js/ is committed on purpose: deploy.sh rsyncs public/ straight from the
# working tree, so a gitignored build output would deploy a site with no JS.
/node_modules/
*.tsbuildinfo

# Scratch outDir for the verify script's "compiled output is current" check
/.tscheck/

# Scratch dir for the verify script's module-graph drift check
/.preloadcheck/

# phpactor writes this on first attach; editor state, not project config
.phpactor.json

# Merged coverage reports (composer coverage)
/build/
