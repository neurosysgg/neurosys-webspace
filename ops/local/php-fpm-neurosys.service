# The confined php-fpm instance. Every line below is asserted by test/confinement_test.sh rather
# than trusted because it reads right; docs/research/attested-single-box.md (Phase 1) says what each one buys.
[Unit]
Description=PHP FastCGI Process Manager — neuro.SYS, confined
After=network.target

[Service]
Type=notify
# The filter is loaded by the master, switched on for every request a worker starts, and installed
# by the worker on its first one. pcre.jit and the opcache JIT buffer are off because
# MemoryDenyWriteExecute refuses the writable-and-executable mapping both would ask for.
ExecStart=/usr/bin/php-fpm --nodaemonize --fpm-config /etc/php-fpm-neurosys/php-fpm.conf \
    -d extension=/usr/local/lib/phpanta/confine.so -d confine.enabled=1 \
    -d pcre.jit=0 -d opcache.jit=disable -d opcache.jit_buffer_size=0
ExecReload=/bin/kill -USR2 $MAINPID
# php.ini alone: the scan directory's xdebug is a debugger in a worker that is assumed owned.
Environment=PHP_INI_SCAN_DIR=
# A killed worker leaves no core: its memory held whatever it had read, session.key included.
LimitCORE=0
Restart=on-failure

User=neurosys-php
Group=neurosys-php
SupplementaryGroups=http
UMask=0007
RuntimeDirectory=php-fpm-neurosys
RuntimeDirectoryMode=0755

# The filesystem: everything read-only, data/ alone writable, home directories gone.
ProtectSystem=strict
ReadWritePaths=/srv/http/neurosys/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# The network: none. The socket httpd speaks to is a file, and a file crosses namespaces.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# The kernel and the identity.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# The unit's own filter covers the master too, so it allows what a master needs; the worker's
# filter (confine.so) takes away the rest. Of two filters the stricter action wins.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @reboot @module @swap @raw-io @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
