{
    "name": "neurosys",
    "private": true,
    "type": "module",
    "description": "Front-end sources for neurosys.gg. Compiles assets/ts/ to public/assets/js/, inlines assets/css/main.css into public/assets/css/style.css, then content-hashes both into src/NeuroSYS/AssetManifest.php.",
    "scripts": {
        "build": "tsc && node tools/build-css.mjs && node tools/build-assets.mjs",
        "build:css": "node tools/build-css.mjs",
        "build:assets": "node tools/build-assets.mjs",
        "watch": "tsc --watch",
        "check": "tsc --noEmit",
        "test": "node --test",
        "coverage": "node --test --experimental-test-coverage --test-coverage-include='public/assets/js/**' --test-coverage-include-all --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100"
    },
    "devDependencies": {
        "jsdom": "^30.0.1",
        "typescript": "^7.0.2"
    }
}
