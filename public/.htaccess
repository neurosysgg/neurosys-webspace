DirectoryIndex index.php

# Strato runs everything under cgi-bin/ as CGI, which 500s static files without this.
# Any new asset type must be added here or it will 500 in production while working locally.
<FilesMatch "\.(css|js|map|svg|png|jpe?g|gif|ico|webp|avif|woff2?)$">
    SetHandler default-handler
</FilesMatch>

RewriteEngine On
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Force HTTPS, before anything else runs. Both gates are HTTP Basic and Basic is base64, so a
# request that arrives in plaintext has already put its credentials on the wire — this redirect
# fixes the next request, and the Strict-Transport-Security header stops there being a plaintext
# one at all. See src/NeuroSYS/Http/Security/StrictTransportSecurity.php.
#
# Two conditions, and both must fail before the redirect fires, because a redirect that triggers on
# a request which already arrived over HTTPS is an infinite loop. Strato terminates TLS at its
# proxy, where %{HTTPS} can read "off" on a request that was encrypted the whole way; there
# X-Forwarded-Proto is the one telling the truth. Neither is reliable alone, so ask both.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Pass real files and directories through (assets, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Everything else → router
RewriteRule ^ index.php [QSA,L]
