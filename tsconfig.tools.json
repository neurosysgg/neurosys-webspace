{
  // The build tools, type-checked. `tsconfig.json` covers assets/ts/ and emits; this one covers
  // tools/*.mjs and emits nothing.
  //
  // These four files write the three committed artefacts — style.css, public/assets/js/ and
  // AssetManifest.php — and until this config existed nothing checked them at all. What already
  // guards them is the verify script, which rebuilds each one and diffs it byte-for-byte; that
  // catches a tool that produces the wrong bytes, and cannot catch a tool that crashes on a path
  // it has never taken. Turning the checker on found two of those in the first run: terser's
  // MinifyOutput has carried no `error` property since terser 5, so build-prod.mjs's failure
  // message had been printing the fallback half of a `??` for as long as it had existed, and
  // esbuild's outputFiles[0] was read without anything saying it was there.
  //
  // Same strictness as tsconfig.json, deliberately — including noUncheckedIndexedAccess, which is
  // what most of that first run was. Where a loop bound or an earlier check is the proof the
  // checker cannot read, the site carries a `@type` cast and a sentence saying which; a guard
  // there would be the dead defensive branch this project refuses elsewhere.
  "include": ["tools/*.mjs"],

  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",

    // Node only. No "dom" — a build tool reaching for `document` should be an error here, which is
    // the one thing this config says that tsconfig.test.json's cannot.
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  }
}
