{
  // The build tools, type-checked. `tsconfig.json` covers assets/ts/ and emits; this one covers
  // tools/*.mjs and emits nothing.
  //
  // These four files write the three committed artefacts — style.css, public/assets/js/ and
  // AssetManifest.php. The verify script rebuilds each one and diffs it byte-for-byte, which
  // catches a tool that produces the wrong bytes and cannot catch one that crashes on a path it has
  // never taken; that second kind is what this config is for. See docs/history/coverage.md.
  //
  // Same strictness as tsconfig.json, deliberately — including noUncheckedIndexedAccess, which is
  // where a build tool's unchecked reads show up. Where a loop bound or an earlier check is the
  // proof the checker cannot read, the site carries a `@type` cast and a sentence saying which; a
  // guard there would be the dead defensive branch this project refuses elsewhere.
  "include": ["tools/*.mjs"],

  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",

    // Node only. No "dom" — a build tool reaching for `document` should be an error here, which is
    // the one thing this config says that tsconfig.test.json's cannot.
    "lib": ["es2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  }
}
